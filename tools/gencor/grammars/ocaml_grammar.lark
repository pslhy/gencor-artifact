              | LT method_type GT
              | HASH class_path
              | LPAREN typexpr _bnf_base_typexpr_star_3 RPAREN HASH class_path
              | LPAREN typexpr RPAREN HASH class_path

poly_typexpr: typexpr
              | _bnf_poly_typexpr_plus_5 DOT typexpr

method_type: LOWERCASE_IDENT COLON poly_typexpr => bnd{false,0}

polymorphic_variant_type: LBRACKET tag_spec_first _bnf_polymorphic_variant_type_star_6 RBRACKET
                          | LBRACKET tag_spec_first RBRACKET
                          | LBRACKET GT tag_spec _bnf_polymorphic_variant_type_star_6 RBRACKET
