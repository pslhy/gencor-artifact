               | LSL => pass_bnd{0},apply_markop{0}
               | LSR => pass_bnd{0},apply_markop{0}
               | ASR => pass_bnd{0},apply_markop{0}

infix_op: INFIX_SYMBOL => pass_bnd{0}
          | STAR
          | PLUS
          | MINUS
          | DOTMINUS
          | EQ
          | NEQ
          | LT
          | GT
          | OR
          | BARBAR
          | AMP
          | ANDAND
          | COLONEQ
          | MOD
          | LAND
          | LOR
          | LXOR
          | LSL
          | LSR
          | ASR

modtype_name: LOWERCASE_IDENT => pass_bnd{0}
              | CAPITALIZED_IDENT

constant: INTEGER_LITERAL
          | FLOATING_LITERAL
          | CHAR_LITERAL
          | STRING_LITERAL
          | CAPITALIZED_IDENT _bnf_constant_plus_0 => kind{0,9},path_tail{1,4}
          | CAPITALIZED_IDENT => kind{0,4}
          | FALSE
          | TRUE
          | LPAREN RPAREN
          | LPAREN _comments_plus RPAREN
          | BEGIN END
          | LBRACKET RBRACKET
          | LBRACKBAR BARBRACK
          | BACKQUOTE CAPITALIZED_IDENT
          | BACKQUOTE LOWERCASE_IDENT

typeconstr: extended_module_path DOT LOWERCASE_IDENT => bnd{false,2},mark{2,1},kind{2,25}
            | LOWERCASE_IDENT => bnd{false,0}

modtype_path: extended_module_path DOT modtype_name => bnd{false,2},kind{2,8}
              | modtype_name => bnd{false,0},kind{0,8}

class_path: CAPITALIZED_IDENT _bnf_constant_plus_0 DOT LOWERCASE_IDENT => bnd{true,3},kind{0,9}
            | CAPITALIZED_IDENT DOT LOWERCASE_IDENT => bnd{true,2},kind{0,9}
            | LOWERCASE_IDENT => bnd{true,0}

classtype_path: extended_module_path DOT LOWERCASE_IDENT => bnd{false,2},mark{2,1},kind{2,25}
                | LOWERCASE_IDENT => bnd{false,0}

// left-recursive (NOT the normalize.py `name (DOT name)*` star): the star form
// shift/reduces `Module.` toward path-extension, so `typeconstr: extended_module_path
// DOT LOWERCASE_IDENT` (e.g. `Buffer.t`) never reduces -- module-qualified types were
// unparseable. Left recursion shifts the DOT first, then LOWERCASE vs CAPITALIZED
// disambiguates the next token. Hand-tweak: do not regenerate via normalize.py.
extended_module_path: extended_module_name
                      | extended_module_path DOT extended_module_name

extended_module_name: CAPITALIZED_IDENT LPAREN extended_module_path RPAREN => kind{0,9}
                      | CAPITALIZED_IDENT => kind{0,9}

constr_decl: CAPITALIZED_IDENT OF typexpr
             | CAPITALIZED_IDENT
             | LPAREN RPAREN OF typexpr
             | LPAREN RPAREN

typexpr: base_typexpr
         | typexpr _bnf_typexpr_plus_2
         | typexpr typeconstr
         | typexpr ARROW typexpr
         | typexpr HASH class_path
         | typexpr AS QUOTE_IDENT

base_typexpr: QUOTE_IDENT
              | UNDERSCORE
              | LPAREN typexpr RPAREN
              | typeconstr
