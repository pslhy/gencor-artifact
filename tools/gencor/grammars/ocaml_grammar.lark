QUESTIONQUESTION: "??"
CAPITALIZED_IDENT: /[A-Z]([a-zA-Z0-9_'']*)/
LOWERCASE_IDENT: /([a-z_][a-zA-Z0-9_'']*)/
INTEGER_LITERAL: /(?:(0x|0X)[0-9a-fA-F](_?[0-9a-fA-F])*|(0o|0O)[0-7](_?[0-7])*|(0b|0B)[01](_?[01])*|(0|[1-9](_?[0-9])*)([lLn])?)/
FLOATING_LITERAL: /(?:(0x|0X)[0-9a-fA-F](_?[0-9a-fA-F])*(\.[0-9a-fA-F](_?[0-9a-fA-F])*)?([pP][+-]?[0-9](_?[0-9])*)?|([0-9](_?[0-9])*\.[0-9](_?[0-9])*([eE][+-]?[0-9](_?[0-9])*)?|[0-9](_?[0-9])*\.([eE][+-]?[0-9](_?[0-9])*)?))/
CHAR_LITERAL.2: /(?:'\\([0-9]{3}|x[0-9a-fA-F]{2}|o[0-3][0-7]{2})'|'([^'\\]|\\[\\'"ntbr ])')/
STRING_LITERAL: /"([^"\\\r\n]|\\[\\'"ntbr ]|\\u\{[0-9a-fA-F]+\}|\r?\n[ \t]*)*"/
QUOTED_STRING_LITERAL: /\{[a-z_]+\|.*?\|\}/
QUOTE_IDENT: /'([A-Z]([a-zA-Z0-9_'']*)|([a-z_][a-zA-Z0-9_'']*))/
INFIX_SYMBOL: /(?:\#(?:(?:\~|!|\?|\$|\&|\*|\+|\-|\/|=|>|@|\^|\||%|<|:|\.))+|(?:\$|\&|\*|\+|\-|\/|=|>|@|\^|\||%|<)(?:(?:\~|!|\?|\$|\&|\*|\+|\-|\/|=|>|@|\^|\||%|<|:|\.))*)/
PREFIX_SYMBOL: /(?:(?:\?|\~)(?:(?:\~|!|\?|\$|\&|\*|\+|\-|\/|=|>|@|\^|\||%|<|:|\.))+|!(?:(?:\~|!|\?|\$|\&|\*|\+|\-|\/|=|>|@|\^|\||%|<|:|\.))*)/

%ignore /[ \t\r\n\f]+/
COMMENT: /\(\*(?:[^*(]|\([^*]|\*+[^)*(]|\*+\([^*]|\(\*(?:[^*(]|\([^*]|\*+[^)*(]|\*+\([^*])*\*+\)|\*+\(\*(?:[^*(]|\([^*]|\*+[^)*(]|\*+\([^*])*\*+\))*\*+\)/

_comments: | _comments COMMENT
_comments_plus: COMMENT | _comments_plus COMMENT