                      | _bnf_pattern_star_11 SEMI LOWERCASE_IDENT => bnd{true,2}

_bnf_pattern_star_12: SEMI pattern
                      | _bnf_pattern_star_12 SEMI pattern

_bnf_expr_star_13: SEMI LOWERCASE_IDENT EQ expr => bnd{true,1}
                   | _bnf_expr_star_13 SEMI LOWERCASE_IDENT EQ expr => bnd{true,2}

_bnf_expr_plus_14: COMMA expr
                   | _bnf_expr_plus_14 COMMA expr

_bnf_expr_star_15: SEMI CAPITALIZED_IDENT _bnf_constant_plus_0 DOT LOWERCASE_IDENT EQ expr => bnd{true,4}
                   | SEMI CAPITALIZED_IDENT DOT LOWERCASE_IDENT EQ expr => bnd{true,3}
                   | SEMI LOWERCASE_IDENT EQ expr => bnd{true,1}
                   | _bnf_expr_star_15 SEMI CAPITALIZED_IDENT _bnf_constant_plus_0 DOT LOWERCASE_IDENT EQ expr => bnd{true,5}
                   | _bnf_expr_star_15 SEMI CAPITALIZED_IDENT DOT LOWERCASE_IDENT EQ expr => bnd{true,4}
                   | _bnf_expr_star_15 SEMI LOWERCASE_IDENT EQ expr => bnd{true,2}

_bnf_expr_plus_16: argument
                   | _bnf_expr_plus_16 argument

_bnf_expr_star_17: AND let_binding
                   | _bnf_expr_star_17 AND let_binding

_bnf_let_binding_star_18: parameter
                          | _bnf_let_binding_star_18 parameter

_bnf_definition_star_19: LPAREN CAPITALIZED_IDENT COLON module_type RPAREN
                         | _bnf_definition_star_19 LPAREN CAPITALIZED_IDENT COLON module_type RPAREN

_bnf_pattern_matching_star_22: BAR pattern WHEN expr ARROW _comments expr__seq _comments
                               | BAR pattern ARROW _comments expr__seq _comments
                               | _bnf_pattern_matching_star_22 BAR pattern WHEN expr ARROW _comments expr__seq _comments
                               | _bnf_pattern_matching_star_22 BAR pattern ARROW _comments expr__seq _comments

_bnf_type_definition_star_23: AND typedef
                              | _bnf_type_definition_star_23 AND typedef

_bnf_type_information_star_24: type_constraint
                               | _bnf_type_information_star_24 type_constraint

_bnf_type_representation_star_25: BAR constr_decl
                                  | _bnf_type_representation_star_25 BAR constr_decl

_bnf_type_representation_star_26: SEMI field_decl
                                  | _bnf_type_representation_star_26 SEMI field_decl

_bnf_type_params_star_27: COMMA type_param
                          | _bnf_type_params_star_27 COMMA type_param

_bnf_class_body_type_star_28: class_field_spec
                              | _bnf_class_body_type_star_28 class_field_spec

_bnf_class_expr_plus_29: LPAREN class_argument RPAREN
                         | _bnf_class_expr_plus_29 LPAREN class_argument RPAREN

_bnf_class_body_star_30: class_field
                         | _bnf_class_body_star_30 class_field

_bnf_class_definition_star_31: AND class_binding
                               | _bnf_class_definition_star_31 AND class_binding

_bnf_class_binding_star_32: LPAREN parameter RPAREN
                            | _bnf_class_binding_star_32 LPAREN parameter RPAREN

_bnf_type_parameters_star_33: COMMA QUOTE_IDENT
                              | _bnf_type_parameters_star_33 COMMA QUOTE_IDENT

_bnf_class_specification_star_34: AND class_spec
                                  | _bnf_class_specification_star_34 AND class_spec

_bnf_classtype_definition_star_35: AND classtype_def
                                   | _bnf_classtype_definition_star_35 AND classtype_def

_bnf_module_type_star_36: specification
                          | _bnf_module_type_star_36 specification

_bnf_module_type_star_37: AND mod_constraint
                          | _bnf_module_type_star_37 AND mod_constraint

_bnf_unit_interface_plus_38: specification SEMICOLON
                             | specification
                             | _bnf_unit_interface_plus_38 specification SEMICOLON
                             | _bnf_unit_interface_plus_38 specification

