// Generated by normalize.py. Semantic tag annotations were removed.

start: program
       | fenced_program

fenced_program: "```typescript" program "```"
                | "```ts" program "```"
                | "```" program "```"

program: _bnf_program_star_0
         | 

?stmt: simple_stmt
       | block
       | if_else_stmt
       | if_stmt
       | for_stmt
       | for_of_stmt
       | for_of_decl_stmt
       | for_of_tuple_decl_stmt
       | while_stmt
       | do_while_stmt
       | function_decl
       | try_catch_stmt
       | throw_stmt
       | line_comment_stmt
       | block_comment_stmt

?simple_stmt: typed_decl_assign_stmt
              | typed_decl_stmt
              | untyped_decl_stmt
              | return_stmt
              | break_stmt
              | continue_stmt
              | expr_stmt
              | empty_stmt

empty_stmt: ";"

typed_decl: let_or_const value_ident ":" type => bnd{false,1}

typed_decl_assign: let_or_const value_ident ":" type EQ_ASSIGN expr => bnd{false,1},xt{true,5}

untyped_decl: let_or_const value_ident EQ_ASSIGN expr => bnd{false,1},xt{false,3}

typed_decl_stmt: typed_decl semi
                 | typed_decl

typed_decl_assign_stmt: typed_decl_assign semi
                        | typed_decl_assign

untyped_decl_stmt: untyped_decl semi
                   | untyped_decl

return_stmt: RETURN expr semi => xt{true,1}
             | RETURN expr => xt{true,1}
             | RETURN semi
             | RETURN

break_stmt: BREAK semi
            | BREAK

continue_stmt: CONTINUE semi
               | CONTINUE

expr_stmt: expr semi => xt{false,0}
           | expr => xt{false,0}

semi: ";"

let_or_const: LET
              | CONST

block: "{" _bnf_program_star_0 "}"

if_stmt: IF "(" condition_expr ")" stmt => xt{false,2}

if_else_stmt: IF "(" condition_expr ")" stmt ELSE stmt => xt{false,2}

function_decl: FUNCTION value_ident "(" typed_param_list ")" ":" type block => bnd{false,1}
               | FUNCTION value_ident "(" ")" ":" type block => bnd{false,1}

typed_param_list: typed_param _bnf_typed_param_list_star_1
                  | typed_param

typed_param: value_ident ":" type => bnd{false,0}

for_stmt: FOR "(" for_init semi expr semi expr ")" stmt => xt{false,4},xt{false,6}
          | FOR "(" semi expr semi expr ")" stmt => xt{false,3},xt{false,5}

?for_init: typed_decl_assign
           | typed_decl
           | untyped_decl
           | expr => xt{false,0}

for_of_stmt: FOR "(" expr OF expr ")" stmt => xt{false,2},xt{false,4}

for_of_decl_stmt: FOR "(" let_or_const value_ident OF expr ")" stmt => bnd{false,3},xt{false,5}

for_of_tuple_decl_stmt: FOR "(" let_or_const "[" value_ident "," value_ident "]" OF expr ")" stmt => bnd{false,4},bnd{false,6},xt{false,9}

while_stmt: WHILE "(" expr ")" block => xt{false,2}

do_while_stmt: DO block WHILE "(" expr ")" semi => xt{false,4}
               | DO block WHILE "(" expr ")" => xt{false,4}

try_catch_stmt: TRY block CATCH "(" value_ident ")" block => bnd{false,4}

throw_stmt: THROW new_expr semi
            | THROW new_expr

line_comment_stmt: LINE_COMMENT

block_comment_stmt: BLOCK_COMMENT

?expr: assignment

?condition_expr: condition_assignment

?condition_assignment: condition_conditional COMPOUND_ASSIGN_OP condition_expr -> assign_expr => xt{false,0},xt{true,2}
                       | condition_conditional EQ_ASSIGN condition_expr -> assign_expr => xt{false,0},xt{true,2}
                       | condition_conditional

?condition_conditional: condition_logical_or
                        | condition_logical_or QUESTION condition_expr ":" condition_expr -> ternary_expr

?condition_logical_or: condition_logical_and
                       | condition_logical_or OR_OP condition_logical_and -> logical_or_expr

?condition_logical_and: condition_equality
                        | condition_logical_and AND_OP condition_equality -> logical_and_expr

?condition_equality: condition_relational
                     | condition_equality EQUALITY_OP condition_relational -> equality_expr

?condition_relational: condition_bitwise_or
                       | condition_relational REL_CMP_OP condition_bitwise_or -> relational_expr
                       | condition_relational LT condition_bitwise_or -> relational_expr
                       | condition_relational GT condition_bitwise_or -> relational_expr

?condition_bitwise_or: condition_bitwise_xor
                       | condition_bitwise_or BIT_OR condition_bitwise_xor -> bitwise_or_expr

?condition_bitwise_xor: condition_bitwise_and
                        | condition_bitwise_xor BIT_XOR condition_bitwise_and -> bitwise_xor_expr

?condition_bitwise_and: condition_shift
                        | condition_bitwise_and BIT_AND condition_shift -> bitwise_and_expr

?condition_shift: condition_additive
                  | condition_shift SHIFT_OP condition_additive -> shift_expr

?condition_additive: condition_multiplicative
                     | condition_additive ADD_OP condition_multiplicative -> additive_expr

?condition_multiplicative: condition_exponent
                           | condition_multiplicative MUL_OP condition_exponent -> multiplicative_expr

?condition_exponent: condition_as_expr
                     | condition_as_expr POW_OP condition_exponent -> power_expr

?condition_as_expr: condition_prefix
                    | condition_as_expr AS type -> as_cast_expr

?condition_prefix: condition_postfix
                   | TYPEOF condition_prefix -> unary_expr
                   | BANG condition_prefix -> unary_expr
                   | BIT_NOT condition_prefix -> unary_expr
                   | ADD_OP condition_prefix -> unary_expr
                   | INC_OP condition_chained -> prefix_inc_expr
                   | DEC_OP condition_chained -> prefix_dec_expr

?condition_postfix: condition_chained
                    | condition_chained INC_OP -> postfix_inc_expr
                    | condition_chained DEC_OP -> postfix_dec_expr

?condition_chained: condition_primary
                    | condition_primary _bnf_condition_chained_plus_2

?condition_primary: value_ident -> identifier => bnd{true,0}
                    | NULL -> null_literal
                    | UNDEFINED -> undefined_literal
                    | TRUE -> true_literal
                    | FALSE -> false_literal
                    | number_literal
                    | bigint_literal
                    | string_literal
                    | template_string
                    | regex_literal
                    | condition_paren_cover
                    | array_or_tuple_literal
                    | object_literal
                    | new_expr

condition_paren_cover: "(" condition_paren_cover_list ")" -> grouped_expr
                       | "(" ")" -> grouped_expr

condition_paren_cover_list: condition_paren_cover_item
                            | condition_paren_cover_item ","
                            | condition_paren_cover_item "," condition_paren_cover_list => xt{false,0}

?condition_paren_cover_item: value_ident ":" type -> typed_param_item => bnd{false,0}
                             | "[" value_ident "," value_ident "]" -> tuple_param_item => bnd{false,1},bnd{false,3}
                             | condition_expr

?assignment: arrow_function
             | conditional COMPOUND_ASSIGN_OP expr -> assign_expr => xt{false,0},xt{true,2}
             | conditional EQ_ASSIGN expr -> assign_expr => xt{false,0},xt{true,2}
             | conditional

?conditional: logical_or
              | logical_or QUESTION expr ":" expr -> ternary_expr

?logical_or: logical_and
             | logical_or OR_OP logical_and -> logical_or_expr

?logical_and: equality
              | logical_and AND_OP equality -> logical_and_expr

?equality: relational
           | equality EQUALITY_OP relational -> equality_expr

?relational: bitwise_or
             | relational REL_CMP_OP bitwise_or -> relational_expr
             | relational LT bitwise_or -> relational_expr
             | relational GT bitwise_or -> relational_expr

?bitwise_or: bitwise_xor
             | bitwise_or BIT_OR bitwise_xor -> bitwise_or_expr

?bitwise_xor: bitwise_and
              | bitwise_xor BIT_XOR bitwise_and -> bitwise_xor_expr

?bitwise_and: shift
              | bitwise_and BIT_AND shift -> bitwise_and_expr

?shift: additive
        | shift SHIFT_OP additive -> shift_expr

?additive: multiplicative
           | additive ADD_OP multiplicative -> additive_expr

?multiplicative: exponent
                 | multiplicative MUL_OP exponent -> multiplicative_expr

?exponent: as_expr
           | as_expr POW_OP exponent -> power_expr

?as_expr: prefix
          | as_expr AS type -> as_cast_expr

?prefix: postfix
         | TYPEOF prefix -> unary_expr
         | BANG prefix -> unary_expr
         | BIT_NOT prefix -> unary_expr
         | ADD_OP prefix -> unary_expr
         | INC_OP chained -> prefix_inc_expr
         | DEC_OP chained -> prefix_dec_expr

?postfix: chained
          | chained INC_OP -> postfix_inc_expr
          | chained DEC_OP -> postfix_dec_expr

?chained: primary
          | primary _bnf_condition_chained_plus_2

?postfix_part: DOT IDENT -> member_access => bnd{true,1}
               | OPTIONAL_DOT IDENT -> optional_member_access => bnd{true,1}
               | "[" expr "," "]" -> computed_access => xt{false,1}
               | "[" expr "]" -> computed_access => xt{false,1}
               | call_suffix
               | BANG -> non_null_assertion

call_suffix: CALL_OPEN argument_list ")" -> call_expr
             | CALL_OPEN ")" -> call_expr

type_args: LT type _bnf_type_args_star_4 GT
           | LT type GT

value_ident: IDENT

argument_list: argument _bnf_argument_list_star_5 ","
               | argument _bnf_argument_list_star_5
               | argument ","
               | argument

?argument: spread_arg
           | expr => xt{true,0}

spread_arg: SPREAD expr => xt{true,1}

?primary: value_ident -> identifier => bnd{true,0}
          | NULL -> null_literal
          | UNDEFINED -> undefined_literal
          | TRUE -> true_literal
          | FALSE -> false_literal
          | number_literal
          | bigint_literal
          | string_literal
          | template_string
          | regex_literal
          | paren_cover
          | array_or_tuple_literal
          | object_literal
          | new_expr
          | anonymous_function

paren_cover: "(" expr ")" paren_cover_tail
             | "(" param_multi_list ")" param_arrow_tail
             | "(" param_single_committed ")" param_arrow_tail
             | "(" ")" param_arrow_tail

?paren_cover_tail: ":" type ARROW arrow_body -> paren_arrow_function
                   | ARROW arrow_body -> paren_arrow_function
                   | -> grouped_expr

param_arrow_tail: ":" type ARROW arrow_body -> paren_arrow_function
                  | ARROW arrow_body -> paren_arrow_function

param_multi_list: param_any_item "," param_multi_rest
param_multi_rest: param_any_item
                  | param_any_item ","
                  | param_any_item "," param_multi_rest

?param_any_item: value_ident -> bare_param_item => bnd{false,0}
                 | param_single_committed
?param_single_committed: value_ident ":" type -> typed_param_item => bnd{false,0}
                         | "[" value_ident "," value_ident "]" ":" type -> tuple_param_item => bnd{false,1},bnd{false,3}
                         | "[" value_ident "," value_ident "]" -> tuple_param_item => bnd{false,1},bnd{false,3}

array_or_tuple_literal: "[" array_or_tuple_elements "]"
                        | "[" "]"

array_or_tuple_elements: array_or_tuple_element array_or_tuple_elements_tail

array_or_tuple_elements_tail: "," array_or_tuple_elements
                              | ","
                              | 

?array_or_tuple_element: spread_arg
                         | expr

object_literal: "{" object_entry _bnf_object_literal_star_7 "," "}"
                | "{" object_entry _bnf_object_literal_star_7 "}"
                | "{" object_entry "," "}"
                | "{" object_entry "}"
                | "{" "}"

object_entry: object_key ":" expr

?object_key: IDENT => bnd{false,0}
             | SINGLE_QUOTED_STRING
             | DOUBLE_QUOTED_STRING
             | NUMBER

new_expr: NEW constructor_call

constructor_call: value_ident type_args CALL_OPEN argument_list ")" => bnd{true,0}
                  | value_ident type_args CALL_OPEN ")" => bnd{true,0}
                  | value_ident CALL_OPEN argument_list ")" => bnd{true,0}
                  | value_ident CALL_OPEN ")" => bnd{true,0}

arrow_function: value_ident ARROW arrow_body => bnd{false,0}

arrow_body: expr
            | block

anonymous_function: FUNCTION CALL_OPEN arrow_param_list ")" block
                    | FUNCTION CALL_OPEN ")" block

arrow_param_list: arrow_param _bnf_arrow_param_list_star_8
                  | arrow_param

?arrow_param: value_ident ":" type => bnd{false,0}
              | value_ident => bnd{false,0}
              | "[" value_ident "," value_ident "]" ":" type => bnd{false,1},bnd{false,3}
              | "[" value_ident "," value_ident "]" => bnd{false,1},bnd{false,3}

?type: union_type

?union_type: postfix_type
             | union_type BIT_OR postfix_type -> union_type_expr

?postfix_type: primary_type _bnf_postfix_type_star_9
               | primary_type

type_array_suffix: "[" "]"

?primary_type: type_ref
               | null_type
               | undefined_type
               | grouped_type
               | function_type
               | tuple_type
               | index_signature_type

type_ref: IDENT type_args => tbnd{true,0}
          | IDENT => tbnd{true,0}

null_type: NULL

undefined_type: UNDEFINED

grouped_type: "(" type ")"

function_type: "(" typed_param_list ")" ARROW type
               | "(" ")" ARROW type

tuple_type: "[" type _bnf_type_args_star_4 "]"
            | "[" type "]"
            | "[" "]"

index_signature_type: "{" "[" IDENT ":" type "]" ":" type ";" "}"
                      | "{" "[" IDENT ":" type "]" ":" type "}"

number_literal: NUMBER

bigint_literal: BIGINT

string_literal: SINGLE_QUOTED_STRING
                | DOUBLE_QUOTED_STRING

regex_literal: REGEX_LITERAL

template_string: TEMPLATE_STRING

_bnf_program_star_0: stmt
                     | _bnf_program_star_0 stmt

_bnf_typed_param_list_star_1: "," typed_param
                              | _bnf_typed_param_list_star_1 "," typed_param

_bnf_condition_chained_plus_2: postfix_part
                               | _bnf_condition_chained_plus_2 postfix_part


_bnf_type_args_star_4: "," type
                       | _bnf_type_args_star_4 "," type

_bnf_argument_list_star_5: "," argument
                           | _bnf_argument_list_star_5 "," argument

_bnf_object_literal_star_7: "," object_entry
                            | _bnf_object_literal_star_7 "," object_entry

_bnf_arrow_param_list_star_8: "," arrow_param
                              | _bnf_arrow_param_list_star_8 "," arrow_param

_bnf_postfix_type_star_9: type_array_suffix
                          | _bnf_postfix_type_star_9 type_array_suffix

WS: /(?:[ \t\f\r\n])+/
ARROW.30: "=>"
FUNCTION.20: "function"
RETURN.20: "return"
LET.20: "let"
CONST.20: "const"
BREAK.20: "break"
CONTINUE.20: "continue"
IF.20: "if"
ELSE.20: "else"
FOR.20: "for"
WHILE.20: "while"
DO.20: "do"
TRY.20: "try"
CATCH.20: "catch"
THROW.20: "throw"
NEW.20: "new"
EQ_ASSIGN.5: "="
CALL_OPEN.10: "("
AS.10: "as"
OF.10: "of"
SPREAD.20: "..."
OPTIONAL_DOT.30: "?."
QUESTION.5: "?"
DOT.10: "."
INC_OP.20: "++"
DEC_OP.20: "--"
BANG.10: "!"
POW_OP.20: "**"
OR_OP.20: "||"
AND_OP.20: "&&"
BIT_OR.10: "|"
BIT_XOR.10: "^"
BIT_AND.10: "&"
LT.10: "<"
GT.10: ">"
NULL.10: "null"
UNDEFINED.10: "undefined"
TRUE.10: "true"
FALSE.10: "false"
COMPOUND_ASSIGN_OP.40: /(?:>>>=|<<=|>>=|\*\*=|\|\|=|\&\&=|\?\?=|\+=|\-=|\*=|\/=|%=|\&=|\|=|\^=)/
EQUALITY_OP.30: /(?:===|!==|==|!=)/
REL_CMP_OP.20: /(?:<=|>=)/
SHIFT_OP.20: /(?:>>>|<<|>>)/
ADD_OP: /(?:\+|\-)/
MUL_OP: /(?:\*|\/|%)/
TYPEOF.10: "typeof"
BIT_NOT.10: "~"
LINE_COMMENT: /\/\/[^\n]*/
BLOCK_COMMENT: /\/\*[\s\S]*?\*\//
IDENT: /[a-zA-Z_][a-zA-Z_0-9]*/
NUMBER: /(((?:[1-9]\d*|0)(?:\.\d*)?|\.\d\d*)(?:[eE][+-]?\d*)?|(0[oO](?:[1-7][0-7]*|0)|0[xX](?:[1-9a-fA-F][0-9a-fA-F]*|0)|0[bB](?:1[01]*|0)|(?:[1-9]\d*|0)))/
BIGINT: /(0[oO](?:[1-7][0-7]*|0)|0[xX](?:[1-9a-fA-F][0-9a-fA-F]*|0)|0[bB](?:1[01]*|0)|(?:[1-9]\d*|0))n/
SINGLE_QUOTED_STRING: /'([^'\\\n]|\\.)*'/
DOUBLE_QUOTED_STRING: /"([^"\\\n]|\\.)*"/
REGEX_LITERAL: /\/(\\.|\[[^\]\n]*\]|[^\/\\\n\s;=])(\\.|\[[^\]\n]*\]|[^\/\\\n;])*\/[gimusy]*/
TEMPLATE_STRING.-1: /`([^`\\]|\\.)*`/

%ignore WS
