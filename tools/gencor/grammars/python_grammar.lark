       | MATCH => pass_bnd{0},name_syn{0},pass_callee{0}
       | CASE => pass_bnd{0},name_syn{0},pass_callee{0}

_bnf_comprehension_test_or_star_expr: test_or_star_expr comp_fors comp_if => ctx{U,0,R,1}
                                      | test_or_star_expr comp_fors => ctx{U,0,R,1}

_bnf_comprehension_key_value: key_value comp_fors comp_if => ctx{U,0,R,1}
                              | key_value comp_fors => ctx{U,0,R,1}

_bnf_comprehension_test: test comp_fors comp_if => ctx{U,0,R,1}
                         | test comp_fors => ctx{U,0,R,1}

_bnf_start_star_0: _NEWLINE
                   | stmt
                   | COMMENT
                   | _bnf_start_star_0 _NEWLINE
                   | _bnf_start_star_0 stmt
                   | _bnf_start_star_0 COMMENT

_bnf_start_star_1: _NEWLINE
                   | _bnf_start_star_1 _NEWLINE

_bnf_file_input_star_2: _NEWLINE
                        | stmt
                        | _bnf_file_input_star_2 _NEWLINE
                        | _bnf_file_input_star_2 stmt

_bnf_decorators_plus_3: decorator
                        | _bnf_decorators_plus_3 decorator

_bnf_parameters_star_4: "," _nls paramvalue
                        | _bnf_parameters_star_4 "," _nls paramvalue

_bnf_lambda_params_star_5: "," _nls lambda_paramvalue
                           | _bnf_lambda_params_star_5 "," _nls lambda_paramvalue

_bnf_simple_stmt_star_6: ";" small_stmt
                         | _bnf_simple_stmt_star_6 ";" small_stmt

_bnf_assign_plus_7: "=" yield_expr
                    | "=" testlist_star_expr
                    | _bnf_assign_plus_7 "=" yield_expr
                    | _bnf_assign_plus_7 "=" testlist_star_expr

_bnf_testlist_star_expr_plus_8: "," _nls test_or_star_expr
                                | _bnf_testlist_star_expr_plus_8 "," _nls test_or_star_expr

_bnf_namelist_star_expr_plus_9: "," _nls name_or_star_expr
                                | _bnf_namelist_star_expr_plus_9 "," _nls name_or_star_expr

_bnf_name_test_plus_10: "," _nls name_test
                        | _bnf_name_test_plus_10 "," _nls name_test

!_bnf_dots_plus_11: DOT
                    | _bnf_dots_plus_11 DOT

_bnf_import_as_names_star_12: "," _nls import_as_name
                              | _bnf_import_as_names_star_12 "," _nls import_as_name

_bnf_dotted_as_names_star_13: "," _nls dotted_as_name
                              | _bnf_dotted_as_names_star_13 "," _nls dotted_as_name

_bnf_dotted_name_star_14: "." name => bnd{false,1}
                          | _bnf_dotted_name_star_14 "." name => bnd{false,2}

_bnf_global_stmt_star_15: "," _nls name => pass_bnd{2}
                          | _bnf_global_stmt_star_15 "," _nls name => pass_bnd{0,3}

_bnf_elifs_star_16: elif_
                    | _bnf_elifs_star_16 elif_

_bnf_except_clauses_plus_17: except_clause
                             | _bnf_except_clauses_plus_17 except_clause

_bnf_with_items_star_18: "," _nls with_item
                         | _bnf_with_items_star_18 "," _nls with_item

_bnf_or_pattern_star_19: "|" closed_pattern
                         | _bnf_or_pattern_star_19 "|" closed_pattern

_bnf_closed_pattern_star_20: "," _nls mapping_item_pattern
                             | _bnf_closed_pattern_star_20 "," _nls mapping_item_pattern

_bnf_attr_pattern_plus_21: "." NAME => bnd{false,1}
                           | _bnf_attr_pattern_plus_21 "." NAME => bnd{false,2}

_bnf_sequence_pattern_star_22: "," _nls sequence_item_pattern
                               | _bnf_sequence_pattern_star_22 "," _nls sequence_item_pattern

_bnf_pos_arg_pattern_star_23: "," _nls as_pattern
                              | _bnf_pos_arg_pattern_star_23 "," _nls as_pattern

_bnf_keyws_arg_pattern_star_24: "," _nls keyw_arg_pattern
                                | _bnf_keyws_arg_pattern_star_24 "," _nls keyw_arg_pattern

_bnf_suite_plus_25: COMMENT
                    | _NEWLINE
                    | _bnf_suite_plus_25 COMMENT
                    | _bnf_suite_plus_25 _NEWLINE

_bnf_suite_star_26: stmt
                    | _NEWLINE
                    | COMMENT
                    | _bnf_suite_star_26 stmt
                    | _bnf_suite_star_26 _NEWLINE
                    | _bnf_suite_star_26 COMMENT

_bnf_or_test_star_27: "or" and_test
                      | _bnf_or_test_star_27 "or" and_test

_bnf_and_test_star_28: "and" not_test_
                       | _bnf_and_test_star_28 "and" not_test_

_bnf_comparison_star_29: comp_op expr
                         | _bnf_comparison_star_29 comp_op expr

_bnf_or_expr_star_30: "|" xor_expr
                      | _bnf_or_expr_star_30 "|" xor_expr

_bnf_xor_expr_star_31: "^" and_expr
                       | _bnf_xor_expr_star_31 "^" and_expr

_bnf_and_expr_star_32: "&" shift_expr
                       | _bnf_and_expr_star_32 "&" shift_expr

_bnf_shift_expr_star_33: _shift_op arith_expr
                         | _bnf_shift_expr_star_33 _shift_op arith_expr

_bnf_arith_expr_star_34: _add_op term
                         | _bnf_arith_expr_star_34 _add_op term

_bnf_term_star_35: _mul_op factor
                   | _bnf_term_star_35 _mul_op factor

_bnf_string_concat_plus_36: string
                            | _bnf_string_concat_plus_36 string

_bnf_subscriptlist_plus_37: "," _nls subscript
                            | _bnf_subscriptlist_plus_37 "," _nls subscript

_bnf_exprlist_plus_38: "," _nls expr
                       | "," _nls star_expr
                       | _bnf_exprlist_plus_38 "," _nls expr
                       | _bnf_exprlist_plus_38 "," _nls star_expr

_bnf_testlist_tuple_plus_39: "," _nls test
                             | _bnf_testlist_tuple_plus_39 "," _nls test

_bnf_dict_exprlist_star_40: "," _nls key_value
                            | "," _nls "**" expr
                            | _bnf_dict_exprlist_star_40 "," _nls key_value
                            | _bnf_dict_exprlist_star_40 "," _nls "**" expr

_bnf_arguments_star_41: "," _nls argvalue
                        | _bnf_arguments_star_41 "," _nls argvalue

_bnf_starargs_star_42: "," _nls stararg
                       | _bnf_starargs_star_42 "," _nls stararg

_bnf_comp_fors_plus_43: comp_for
                        | _bnf_comp_fors_plus_43 comp_for

SLASH: "/"
AWAIT: "await"
ASYNC: "async"
_NEWLINE: /\r?\n[\t ]*/
NAME: /[^\W\d]\w*/
COMMENT: /#[^\n]*/
STRING: /(?:([ubf]?r?|r[ubf])'(\\.|[^'\n\\])*'|([ubf]?r?|r[ubf])"(\\.|[^"\n\\])*")/
LONG_STRING: /(?:'''(?:\\.|[^'\\]|'[^']|''[^'])*'''|"""(\\.|[^"\\]|"[^"]|""[^"])*""")/
_SPECIAL_DEC: /[0-9](?:(?:_)?[0-9])*/
DEC_NUMBER: /(?:[1-9](?:(?:_)?[0-9])*|0(?:_(?:0)*)*)/
HEX_NUMBER.2: /0(?:x|X)(?:(?:_)?(?:[0-9]|[a-f]|[A-F]))+/
OCT_NUMBER.2: /0(?:o|O)(?:(?:_)?[0-7])+/
BIN_NUMBER.2: /0(?:b|B)(?:(?:_)?[0-1])+/
_EXP: /(?:e|E)(?:(?:\+|\-))?[0-9](?:(?:_)?[0-9])*/
DECIMAL: /(?:[0-9](?:(?:_)?[0-9])*\.(?:[0-9](?:(?:_)?[0-9])*)?|\.[0-9](?:(?:_)?[0-9])*)/
FLOAT_NUMBER.2: /(?:[0-9](?:(?:_)?[0-9])*(?:e|E)(?:(?:\+|\-))?[0-9](?:(?:_)?[0-9])*|(?:[0-9](?:(?:_)?[0-9])*\.(?:[0-9](?:(?:_)?[0-9])*)?|\.[0-9](?:(?:_)?[0-9])*)(?:(?:e|E)(?:(?:\+|\-))?[0-9](?:(?:_)?[0-9])*)?)/
IMAG_NUMBER.2: /(?:(?:[0-9](?:(?:_)?[0-9])*(?:e|E)(?:(?:\+|\-))?[0-9](?:(?:_)?[0-9])*|(?:[0-9](?:(?:_)?[0-9])*\.(?:[0-9](?:(?:_)?[0-9])*)?|\.[0-9](?:(?:_)?[0-9])*)(?:(?:e|E)(?:(?:\+|\-))?[0-9](?:(?:_)?[0-9])*)?)|[0-9](?:(?:_)?[0-9])*)(?:J|j)/
AT: "@"
STAR: "*"
TOK_ANON_4: "+="
TOK_ANON_5: "-="
TOK_ANON_6: "*="
TOK_ANON_7: "@="
TOK_ANON_8: "/="
TOK_ANON_9: "%="
TOK_ANON_10: "&="
TOK_ANON_11: "|="
TOK_ANON_12: "^="
TOK_ANON_13: "<<="
TOK_ANON_14: ">>="
TOK_ANON_15: "**="
TOK_ANON_16: "//="
DOT: "."
IN: "in"
CASE: "case"
NOT: "not"
PLUS: "+"
MINUS: "-"
TILDE: "~"
TOK_ANON_17: "<<"
TOK_ANON_18: ">>"
PERCENT: "%"
TOK_ANON_19: "//"
LESSTHAN: "<"
MORETHAN: ">"
TOK_ANON_20: "=="
TOK_ANON_21: ">="
TOK_ANON_22: "<="
TOK_ANON_23: "!="
IS: "is"
MATCH: "match"

%declare _DEDENT _INDENT

%ignore /[\t \f]+/
%ignore /\\[\t \f]*\r?\n/

_nls: | _nls _NEWLINE | _nls COMMENT _NEWLINE
_nls1: _NEWLINE | COMMENT _NEWLINE | _nls1 _NEWLINE | _nls1 COMMENT _NEWLINE