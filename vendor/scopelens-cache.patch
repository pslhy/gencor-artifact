+"""Prepare ScopeLens/Jedi caches using real member queries, without an LLM.
+
+Run after installing the packages to be analyzed.
+Disk files are Parso's own parse cache, not serialized completion results.
+"""
+import argparse
+import keyword
+import os
+from pathlib import Path
+import sys
+import time
+
+
+def load_modules(path):
+    modules = []
+    for line_number, line in enumerate(Path(path).read_text().splitlines(), 1):
+        name = line.split("#", 1)[0].strip()
+        if not name:
+            continue
+        if not all(part.isidentifier() and not keyword.iskeyword(part)
+                   for part in name.split(".")):
+            raise ValueError(f"{path}:{line_number}: invalid module name: {name!r}")
+        if name not in modules:
+            modules.append(name)
+    if not modules:
+        raise ValueError(f"Empty ScopeLens warmup module list: {path}")
+    return modules
+
+
+def warm_modules(modules, complete, *, phase):
+    started = time.perf_counter()
+    for module in modules:
+        print(f"[ScopeLens {phase}] START {module}", file=sys.stderr, flush=True)
+        before = time.perf_counter()
+        # Import aliases and package distribution names need not be identical.
+        # A module's qualified name, not the alias, is the provider's cache key.
+        code = f"import {module} as _scopelens_warmup\n_scopelens_warmup."
+        try:
+            members = complete(code, 1, len("_scopelens_warmup."))
+            if not members:
+                raise RuntimeError("no module members returned; check installation/server logs")
+        except Exception as exc:
+            print(f"[ScopeLens {phase}] FAIL {module}: {type(exc).__name__}: {exc}",
+                  file=sys.stderr, flush=True)
+            raise
+        print(f"[ScopeLens {phase}] OK {module}: {len(members)} members, "
+              f"{time.perf_counter() - before:.6f}s", file=sys.stderr, flush=True)
+    elapsed = time.perf_counter() - started
+    print(f"[ScopeLens {phase}] DONE {len(modules)} modules, {elapsed:.6f}s",
+          file=sys.stderr, flush=True)
+    return elapsed
+
+
+def main():
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--modules", required=True, type=Path,
+                        help="one importable module name per line; # comments allowed")
+    parser.add_argument("--cache-home", required=True, type=Path,
+                        help="dedicated XDG cache directory; existing files are not deleted")
+    args = parser.parse_args()
+    modules = load_modules(args.modules)
+    cache_home = args.cache_home.resolve()
+    cache_home.mkdir(parents=True, exist_ok=True)
+    # Must precede Jedi/Parso import. Install and run with the ScopeLens Python.
+    os.environ["XDG_CACHE_HOME"] = str(cache_home)
+    from importlib.metadata import version
+    import jedi
+    from scopelens.member_provider import JediModuleMemberProvider
+
+    print(f"[ScopeLens disk] Python={sys.executable} ({sys.version.split()[0]}) "
+          f"Jedi={version('jedi')} Parso={version('parso')} cache={jedi.settings.cache_directory}",
+          file=sys.stderr, flush=True)
+    warm_modules(modules, JediModuleMemberProvider().complete, phase="disk")
+
+
+if __name__ == "__main__":
+    main()
