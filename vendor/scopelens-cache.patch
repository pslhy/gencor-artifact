+"""Process-lifetime Parso cache for ScopeLens' private Jedi process.
+
+Keep source mtimes and pickle format intact. Refresh residency on insertion
+(new parses and old pickles) and direct lookup (including Jedi's imported
+get_parso_cache_node). Never evict by elapsed time or entry count: wall-clock
+pruning makes reparsing costs depend on machine load and unrelated queries.
+Changed sources still replace their own entries through Parso's normal parser.
+Memory is reclaimed when the owning server exits; disk cleanup is explicit.
+All Jedi objects are consumed under the query lock; only names/bools escape.
+"""
+from __future__ import annotations
+
+from contextlib import contextmanager
+from threading import RLock
+
+import parso
+from parso import cache
+
+_lock = RLock()
+_installed = False
+
+
+class _AccessMap(dict):
+    def __getitem__(self, key):
+        item = super().__getitem__(key)
+        item.last_used = cache.time.time()
+        return item
+
+    def get(self, key, default=None):
+        try:
+            return self[key]
+        except KeyError:
+            return default
+
+
+def _set_cache_item(grammar, path, item):
+    with _lock:
+        # Usage metadata is retained for compatibility, never for eviction.
+        item.last_used = cache.time.time()
+        cache.parser_cache.setdefault(grammar, _AccessMap())[path] = item
+
+
+def _keep_disk_cache(cache_path=None):
+    # Parso otherwise scans/deletes disk entries according to wall-clock age
+    # when saving a parse. Cache preparation/cleanup belongs outside queries.
+    pass
+
+
+def install():
+    """Install once, before creating any Jedi Script in this process."""
+    global _installed
+    with _lock:
+        if _installed:
+            return
+        if parso.__version__ != "0.8.7":
+            raise RuntimeError(f"ScopeLens cache repair requires Parso 0.8.7, got {parso.__version__}")
+        for grammar, items in cache.parser_cache.items():
+            cache.parser_cache[grammar] = _AccessMap(items)
+        # Parso calls this through its cache module, including after unpickling.
+        # The outer parser_cache object stays intact for Jedi's imported aliases.
+        cache._set_cache_item = _set_cache_item
+        cache._remove_cache_and_update_lock = _keep_disk_cache
+        _installed = True
+
+
+@contextmanager
+def analysis_query():
+    with _lock:
+        install()
+        yield
